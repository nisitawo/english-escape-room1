<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Lily & Leo's English Escape Room</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{--pink:#ffc2dc;--blue:#bfe3ff;--lav:#d9ccff;--cream:#fff7e6;--sun:#ffe27a;--ink:#5a4a82;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100vh;font-family:"Baloo 2","Fredoka","Comic Sans MS","Trebuchet MS",sans-serif;color:var(--ink);background:linear-gradient(160deg,#ffd9ec,#d9ecff 50%,#e6dcff);background-attachment:fixed}
#app{max-width:480px;margin:0 auto;padding:10px;animation:fade .5s}
@keyframes fade{from{opacity:0;transform:translateY(12px)}to{opacity:1}}
@keyframes bob{50%{transform:translateY(-4px)}}@keyframes pop{0%{transform:scale(.6);opacity:0}80%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}
@keyframes pulse{50%{opacity:.35;transform:scale(1.25)}}@keyframes shake{25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}
.card{background:#fffaf2;border:3px solid #fff;border-radius:26px;box-shadow:0 8px 0 #e9d6f5,0 14px 24px #b79cd355;padding:14px;margin:10px 0;animation:pop .4s}
.hud{display:flex;gap:6px;justify-content:space-between;align-items:center}
.pill{background:#fff;border-radius:99px;padding:4px 12px;font-weight:700;box-shadow:0 3px 0 #e9d6f5;font-size:15px}
h1{font-size:34px;margin:4px 0;color:#ff6fa8;text-shadow:0 3px 0 #fff}h2{margin:4px 0;font-size:21px}
.btn{font:inherit;font-weight:800;font-size:18px;border:0;border-radius:99px;padding:11px 22px;background:linear-gradient(#ffb3d3,#ff8ebd);color:#fff;box-shadow:0 5px 0 #e0649b;cursor:pointer;transition:.1s}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 #e0649b}.btn.blue{background:linear-gradient(#a9d8ff,#7cbcf5);box-shadow:0 5px 0 #4f93d3}.btn.sun{background:linear-gradient(#ffe98f,#ffd24d);color:#7a5a00;box-shadow:0 5px 0 #d6a520}
.opt{display:block;width:100%;margin:8px 0;text-align:left;font:inherit;font-weight:700;font-size:18px;padding:12px 16px;border-radius:18px;border:3px solid #e6d9ff;background:#fff;color:var(--ink);cursor:pointer;box-shadow:0 4px 0 #e6d9ff}
.opt:hover{background:#f6efff}.opt.bad{background:#ffe0e6;border-color:#ff9bb0;animation:shake .4s;pointer-events:none}.opt.good{background:#d8f8d8;border-color:#7fd67f}
.bar{height:14px;background:#fff;border-radius:99px;overflow:hidden;border:2px solid #e6d9ff}.bar i{display:block;height:100%;background:linear-gradient(90deg,#ffe27a,#ff9ec7);width:100%;transition:width 1s linear}
.ov{position:fixed;inset:0;background:#6b4fa044;backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:12px;z-index:5;overflow:auto}
.ov .card{max-width:450px;width:100%}.obj{cursor:pointer}.obj:hover{filter:brightness(1.08) drop-shadow(0 0 5px #fff)}.sp{animation:pulse 1.4s infinite;transform-box:fill-box;transform-origin:center}
.bobc{animation:bob 2.4s infinite;transform-box:fill-box}.pass{background:#fff3cf;border-radius:16px;padding:10px;font-size:16px;margin-bottom:6px;border:2px dashed #ffd24d}
.inv{display:flex;gap:6px;flex-wrap:wrap;min-height:38px}.dots{display:flex;gap:6px}.dots b{width:26px;height:10px;border-radius:9px;background:#fff;border:2px solid #e6d9ff}.dots b.on{background:#ff9ec7}
.say{display:flex;align-items:center;gap:8px}.say div{background:#fff;border-radius:18px;padding:8px 12px;font-weight:700;flex:1}
</style></head><body><div id="app"></div>
<script>
const COL=['#ff9ec7','#8fcfff','#b79cff','#ffd24d','#7fe0b0'];
const S=[
{n:'Vocabulary Adventure',t:'Find the keys with word power!',q:[
['Which word is a fruit?',['apple','chair','pencil','door'],'You can eat it. It can be red or green.'],
['A ___ is a place where you learn.',['school','kitchen','garden','bank'],'Students go there every day.'],
['The opposite of "big" is ___.',['small','tall','long','fast'],'An ant is ___.'],
['Which one is a color?',['purple','table','happy','run'],'Grapes can be this color.'],
['I write with a ___.',['pencil','spoon','shoe','cup'],'It is in your pencil case.']]},
{n:'Grammar Mystery',t:'Pick the right grammar to open the clues!',q:[
['She ___ a student.',['is','am','are','be'],'Use "is" with she, he, it.'],
['I ___ breakfast every day.',['eat','eats','eating','is eat'],'Use the base verb with "I".'],
['There ___ two cats in the room.',['are','is','am','be'],'Two cats = plural.'],
['He ___ to school by bus.',['goes','go','going','gone'],'He/she/it + verb with -s or -es.'],
['___ you like pizza?',['Do','Does','Is','Are'],'Use "Do" with you.']]},
{n:'Reading Detective',t:'Read the clue, then solve the case!',p:'Mina has a red bag. In her bag, she has two books and one pen. She likes English.',q:[
['What color is Mina\'s bag?',['Red','Blue','Pink','Green'],'Look at the first sentence.'],
['How many books does Mina have?',['Two','One','Three','Five'],'Read the second sentence.'],
['What does Mina like?',['English','Math','Music','Sport'],'Look at the last sentence.'],
['What else is in her bag?',['A pen','A cat','An apple','A ruler'],'Books and ...?'],
['Which sentence is true?',['Mina has a red bag.','Mina has five pens.','Mina has a blue bag.','Mina hates English.'],'Check the story again.']]},
{n:'The Secret Code',t:'Crack the codes to unlock the chest!',q:[
['A=1, B=2, C=3. Which letter is 2?',['B','A','C','D'],'Count: A, B ...'],
['Unscramble: K-O-B-O',['BOOK','KOOB','OBOK','BOKO'],'You read it.'],
['Write "seven" as a number.',['7','6','17','70'],'It is after six.'],
['A, B, C, __, E. Find the missing letter.',['D','F','G','H'],'It comes after C.'],
['"god" backwards is ___.',['dog','gdo','odg','ogd'],'Read from right to left.']]},
{n:'The Final Escape',t:'One last mix. Open the big door!',q:[
['Which word is a day?',['Monday','Money','Month','Maple'],'Mon, Tues, Wed...'],
['We say "Good morning" in the ___.',['morning','night','evening','afternoon'],'Think about the sun rising.'],
['My birthday is ___ May.',['in','on','at','to'],'Use "in" with months.'],
['Which sentence is correct?',['He has a dog.','He have a dog.','He haves a dog.','He having a dog.'],'Use "has" with he.'],
['"Thank you" means ___.',['ขอบคุณ','สวัสดี','ขอโทษ','ลาก่อน'],'We say it to be polite.']]}];
let G,T,TL;const $=id=>document.getElementById(id);
function newG(){G={st:0,res:S.map(()=>[]),score:0,q:null,hint:false,tm:false,mood:['happy','happy'],scr:'title',shuf:[]}}
function ch(who,mood,x,y,h){const L=who=='lily',hair=L?'#d96a9c':'#5b4a9a',blazer=L?'#fff':'#7fb2ff';
let mouth=mood=='sad'?'<path d="M43 81 Q50 73 57 81" stroke="#d6577a" stroke-width="2.5" fill="none" stroke-linecap="round"/>':mood=='think'?'<ellipse cx="50" cy="79" rx="3" ry="3.5" fill="#ff7a9a"/>':'<path d="M41 75 Q50 89 59 75 Z" fill="#ff7a9a" stroke="#d6577a" stroke-width="1.5" stroke-linejoin="round"/>';
let brow=mood=='sad'?'<path d="M27 42 L42 46 M73 42 L58 46" stroke="'+hair+'" stroke-width="3" stroke-linecap="round"/>':'';
let hairB=L?`<circle cx="12" cy="78" r="13" fill="${hair}"/><circle cx="88" cy="78" r="13" fill="${hair}"/><ellipse cx="50" cy="52" rx="38" ry="36" fill="${hair}"/>`:`<ellipse cx="50" cy="50" rx="36" ry="33" fill="${hair}"/>`;
let hairF=L?`<path d="M14 52 Q18 14 50 16 Q82 14 86 52 Q70 34 50 38 Q30 34 14 52Z" fill="${hair}"/><path d="M82 24 l10-4 -2 12z M82 24 l8 8 -12 2z" fill="#ff4f86"/><circle cx="82" cy="26" r="4" fill="#ffe27a"/>`:`<path d="M14 54 Q12 18 30 14 L36 4 L44 14 L56 2 L62 14 L74 8 L76 18 Q90 24 86 54 Q74 34 50 38 Q28 34 14 54Z" fill="${hair}"/>`;
let body=L?`<path d="M28 98 Q50 90 72 98 L78 128 H22Z" fill="#fff"/><path d="M36 93 L50 112 L64 93 Q50 100 36 93Z" fill="#8fcfff"/><path d="M50 106 l-8 8 8 -3 8 3z" fill="#ff6fa8"/><path d="M20 126 H80 L88 148 H12Z" fill="#b79cff"/><path d="M30 126 l-4 22 M42 126 l-2 22 M58 126 l2 22 M70 126 l4 22" stroke="#9d80f0" stroke-width="2"/>`:`<path d="M26 96 Q50 88 74 96 L80 134 H20Z" fill="${blazer}"/><path d="M40 92 L50 112 L60 92Z" fill="#fff"/><path d="M50 100 l-4 6 4 14 4-14z" fill="#ffd24d"/><path d="M40 92 L50 118 L34 100Z M60 92 L50 118 L66 100Z" fill="#5d93e6"/><rect x="22" y="132" width="56" height="14" rx="4" fill="#d9ccff"/>`;
return `<svg x="${x}" y="${y}" height="${h}" width="${h*.625}" viewBox="0 0 100 160" overflow="visible"><g class="bobc">
<rect x="34" y="144" width="12" height="12" rx="4" fill="#ffe3d0"/><rect x="54" y="144" width="12" height="12" rx="4" fill="#ffe3d0"/><ellipse cx="38" cy="158" rx="10" ry="4" fill="#ff8ebd"/><ellipse cx="62" cy="158" rx="10" ry="4" fill="#ff8ebd"/>
<rect x="12" y="98" width="12" height="28" rx="6" fill="${L?'#fff':blazer}"/><rect x="76" y="98" width="12" height="28" rx="6" fill="${L?'#fff':blazer}"/>${hairB}${body}
<ellipse cx="50" cy="58" rx="33" ry="30" fill="#ffe8d8"/>${hairF}
<ellipse cx="36" cy="60" rx="8.5" ry="11" fill="#5a4a9a"/><ellipse cx="64" cy="60" rx="8.5" ry="11" fill="#5a4a9a"/><ellipse cx="36" cy="64" rx="5" ry="6" fill="#8f7be0"/><ellipse cx="64" cy="64" rx="5" ry="6" fill="#8f7be0"/>
<circle cx="33" cy="55" r="3.6" fill="#fff"/><circle cx="61" cy="55" r="3.6" fill="#fff"/><circle cx="39" cy="66" r="1.8" fill="#fff"/><circle cx="67" cy="66" r="1.8" fill="#fff"/>
<ellipse cx="24" cy="72" rx="6" ry="3.5" fill="#ff9ab5" opacity=".7"/><ellipse cx="76" cy="72" rx="6" ry="3.5" fill="#ff9ab5" opacity=".7"/>${brow}${mouth}
${mood=='happy'?'<path d="M92 20 l3 7 7 3 -7 3 -3 7 -3-7 -7-3 7-3z" fill="#ffd24d" class="sp"/>':''}</g></svg>`}
function key(c,s=26){return `<svg width="${s}" height="${s}" viewBox="0 0 30 30"><circle cx="9" cy="10" r="7" fill="${c}" stroke="#fff" stroke-width="2"/><circle cx="9" cy="10" r="2.5" fill="#fff"/><path d="M14 14 L26 26 M21 21 l3-3 M24 24 l3-3" stroke="${c}" stroke-width="4" stroke-linecap="round"/></svg>`}
function scene(){const r=G.res[G.st],ok=i=>r[i]!=null,c=COL[G.st];
const mk=(i,x,y)=>ok(i)?`<g transform="translate(${x} ${y})">${key(c,22).replace('<svg','<svg class="bobc"')}</g>`:`<path class="sp" d="M${x+10} ${y} l3 7 7 3 -7 3 -3 7 -3-7 -7-3 7-3z" fill="#ffd24d" stroke="#fff"/>`;
return `<svg viewBox="0 0 400 290" style="width:100%;border-radius:22px;border:3px solid #fff;box-shadow:0 6px 0 #e9d6f5;display:block">
<defs><linearGradient id="w" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd6ea"/><stop offset="1" stop-color="#fff3df"/></linearGradient></defs>
<rect width="400" height="290" fill="url(#w)"/><g fill="#fff" opacity=".6"><circle cx="40" cy="30" r="14"/><circle cx="360" cy="48" r="9"/><circle cx="150" cy="22" r="6"/></g>
<rect x="250" y="20" width="84" height="64" rx="10" fill="#bfe3ff" stroke="#fff" stroke-width="5"/><path d="M292 20V84M250 52H334" stroke="#fff" stroke-width="4"/><ellipse cx="270" cy="38" rx="12" ry="6" fill="#fff"/>
<rect y="236" width="400" height="54" fill="#ffe6c7"/><path d="M0 236H400" stroke="#ffd2a0" stroke-width="3"/>
<path d="M90 8h30M105 8v5" stroke="#ff8ebd" stroke-width="3"/><path d="M120 8q-10 14-30 0" fill="none" stroke="#ffc2dc" stroke-width="3"/>
<g class="obj" onclick="openQ(0)"><rect x="10" y="66" width="80" height="172" rx="8" fill="#e8b98a" stroke="#c98f5e" stroke-width="3"/><path d="M14 112H86M14 158H86M14 204H86" stroke="#c98f5e" stroke-width="4"/>
<g stroke="#fff" stroke-width="1.5"><rect x="18" y="82" width="9" height="30" fill="#ff9ec7"/><rect x="28" y="88" width="9" height="24" fill="#8fcfff"/><rect x="38" y="80" width="9" height="32" fill="#ffd24d"/><rect x="52" y="86" width="12" height="26" fill="#b79cff"/><rect x="18" y="130" width="12" height="28" fill="#7fe0b0"/><rect x="32" y="126" width="9" height="32" fill="#ff9ec7"/><rect x="50" y="134" width="30" height="24" fill="#ffd24d"/><rect x="20" y="176" width="40" height="28" fill="#8fcfff"/><rect x="62" y="182" width="12" height="22" fill="#ff9ec7"/></g></g>${mk(0,36,38)}
<g class="obj" onclick="openQ(1)"><rect x="175" y="198" width="120" height="14" rx="6" fill="#f7c98d" stroke="#d99a55" stroke-width="3"/><rect x="185" y="212" width="8" height="26" fill="#d99a55"/><rect x="277" y="212" width="8" height="26" fill="#d99a55"/><rect x="205" y="212" width="60" height="22" rx="5" fill="#ffe3b8" stroke="#d99a55" stroke-width="2"/><circle cx="235" cy="223" r="3.5" fill="#ff8ebd"/></g>${mk(1,215,170)}
<g class="obj" onclick="openQ(2)"><path d="M256 198v-8M246 198h20" stroke="#d99a55" stroke-width="4"/><circle cx="256" cy="172" r="17" fill="#8fcfff" stroke="#fff" stroke-width="3"/><path d="M247 168q6-8 10 0t-4 8zM260 176q6-2 8 4" fill="#7fe0b0"/></g>${mk(2,246,134)}
<g class="obj" onclick="openQ(3)"><rect x="338" y="226" width="56" height="38" rx="6" fill="#ffd24d" stroke="#d6a520" stroke-width="3"/><path d="M338 226q28-26 56 0z" fill="#ffe27a" stroke="#d6a520" stroke-width="3"/><rect x="361" y="228" width="10" height="14" rx="3" fill="#ff8ebd"/></g>${mk(3,355,190)}
<g class="obj" onclick="openQ(4)"><circle cx="200" cy="50" r="23" fill="#fff" stroke="#b79cff" stroke-width="5"/><path d="M200 50V35M200 50l11 6" stroke="#5a4a82" stroke-width="3" stroke-linecap="round"/><circle cx="200" cy="50" r="2.5" fill="#ff6fa8"/></g>${mk(4,176,6)}
${ch('lily',G.mood[0],98,112,126)}${ch('leo',G.mood[1],298,98,126)}</svg>`}
function hud(){const done=G.res[G.st].filter(x=>x!=null).length;
return `<div class="hud"><span class="pill">Stage ${G.st+1}/5</span><span class="pill">Score ${G.score}</span><span class="pill" style="color:#d6a000">★ ${G.res.flat().filter(x=>x=='s').length}</span></div>`}
function render(){let h='';const a=$('app');
if(G.scr=='title'){h=`<div class="card" style="text-align:center;background:linear-gradient(#fff,#ffeef7)"><h1>English Escape Room</h1><div style="font-size:18px;font-weight:700">Help Lily and Leo escape the magic classroom!</div>
<svg viewBox="0 0 400 190" style="width:100%"><rect width="400" height="190" rx="22" fill="#d9ecff"/><circle cx="60" cy="40" r="18" fill="#ffe27a"/><g fill="#fff"><ellipse cx="300" cy="40" rx="40" ry="14"/><ellipse cx="120" cy="60" rx="30" ry="10"/></g>${ch('lily','happy',90,10,170)}${ch('leo','happy',210,10,170)}</svg>
<div style="margin:6px 0 12px;font-size:15px">5 stages · 25 questions · Grade 7 · A1–A2</div><button class="btn" onclick="G.scr='room';render()">Start Adventure!</button></div>`}
else if(G.scr=='room'){const s=S[G.st],r=G.res[G.st],done=r.filter(x=>x!=null).length;
h=`${hud()}<div class="card" style="padding:10px"><h2 style="color:${COL[G.st]=='#ffd24d'?'#c29400':COL[G.st]}">${s.n}</h2><div class="dots">${[0,1,2,3,4].map(i=>`<b class="${r[i]!=null?'on':''}"></b>`).join('')}</div>${scene()}
<div class="say">${G.mood[0]=='sad'?'':''}<div id="say">${done==5?'All keys found! Open the door!':s.t+' Tap a glowing object!'}</div></div></div>
<div class="card" style="padding:10px"><b>Inventory</b><div class="inv">${G.res.map((rr,si)=>rr.map(x=>x!=null?key(COL[si]):'').join('')).join('')||'<span style="opacity:.6">Empty. Find keys!</span>'}</div></div>
${done==5?`<div style="text-align:center"><button class="btn sun" onclick="nextStage()">Unlock the Door!</button></div>`:''}`}
else if(G.scr=='clear'){const r=G.res[G.st],st=r.filter(x=>x=='s').length;h=`<div class="card" style="text-align:center"><h1>Stage Clear!</h1><svg viewBox="0 0 400 170" style="width:100%">${ch('lily','happy',100,6,160)}${ch('leo','happy',200,6,160)}</svg>
<div style="font-size:34px;color:#ffc400;letter-spacing:6px">${'★'.repeat(Math.max(1,Math.ceil(st*3/5)))}<span style="color:#e6d9ff">${'★'.repeat(3-Math.max(1,Math.ceil(st*3/5)))}</span></div><p>${st}/5 answered without hints!</p><button class="btn" onclick="G.st++;G.scr='room';G.mood=['happy','happy'];render()">Next: ${S[G.st+1].n}</button></div>`}
else if(G.scr=='win'){const st=G.res.flat().filter(x=>x=='s').length;h=`<div class="card" style="text-align:center;background:linear-gradient(#fff9d6,#ffe9f4)"><h1>You Escaped!</h1><svg viewBox="0 0 400 210" style="width:100%"><rect width="400" height="210" rx="22" fill="#e6dcff"/>${[30,90,200,300,350].map((x,i)=>`<path class="sp" style="animation-delay:${i*.3}s" d="M${x} 20 l5 12 12 5 -12 5 -5 12 -5-12 -12-5 12-5z" fill="#ffd24d"/>`).join('')}${ch('lily','happy',90,25,180)}${ch('leo','happy',210,25,180)}</svg>
<div style="font-size:20px;font-weight:800">Final Score: ${G.score}</div><div style="font-size:30px;color:#ffc400">★ ${st} / 25</div><div class="inv" style="justify-content:center">${COL.map(c=>key(c,34)).join('')}</div><p>Amazing English, detective!</p><button class="btn" onclick="newG();G.scr='room';render()">Play Again</button></div>`}
if(G.q!=null)h+=qView();a.innerHTML=h}
function qView(){const s=S[G.st],q=s.q[G.q],o=G.shuf;
return `<div class="ov"><div class="card"><div class="hud"><span class="pill">Question ${G.q+1}/5</span><span class="pill" id="tl">⏱ ${TL}</span></div><div class="bar" style="margin:8px 0"><i id="tb"></i></div>
<div class="say" style="margin:4px 0">${ch2()}<div style="font-size:19px">${s.p&&G.st==2?`<div class="pass">${s.p}</div>`:''}${q[0]}</div></div>
${o.map((t,i)=>`<button class="opt" id="o${i}" onclick="ans(${i})">${'ABCD'[i]}. ${t}</button>`).join('')}
<div id="hint" style="min-height:24px;font-weight:700;color:#d6577a">${G.hint?'Hint: '+q[2]:''}</div>
<div style="display:flex;justify-content:space-between"><button class="btn sun" style="font-size:15px;padding:8px 16px" onclick="hint()">Hint (-10)</button><button class="btn blue" style="font-size:15px;padding:8px 16px" onclick="closeQ()">Back</button></div></div></div>`}
function ch2(){return `<svg width="64" height="82" viewBox="0 0 100 130"><g>${ch('lily',G.mood[0],0,-4,160).replace(/<svg x="0" y="-4" height="160" width="100"/,'<svg x="0" y="-4" height="160" width="100"')}</g></svg>`}
function openQ(i){const r=G.res[G.st];if(r[i]!=null){G.mood=['happy','happy'];$('say').textContent='You already found this key!';return}
G.q=i;G.hint=false;G.tm=false;TL=30;const q=S[G.st].q[i];G.shuf=q[1].map((t,k)=>[t,k]).sort(()=>Math.random()-.5).map(x=>x[0]);G.mood=['think','think'];render();startT()}
function startT(){clearInterval(T);T=setInterval(()=>{TL--;const e=$('tl');if(e)e.textContent='⏱ '+TL;const b=$('tb');if(b)b.style.width=(TL/30*100)+'%';if(TL<=0){TL=30;G.tm=true;const e2=$('hint');if(e2)e2.textContent="Time's up! No time bonus, try again!"}},1000);setTimeout(()=>{const b=$('tb');if(b)b.style.width='96%'},50)}
function hint(){if(G.hint)return;G.hint=true;G.score=Math.max(0,G.score-10);$('hint').textContent='Hint: '+S[G.st].q[G.q][2]}
function closeQ(){clearInterval(T);G.q=null;G.mood=['happy','happy'];render()}
function ans(i){const q=S[G.st].q[G.q],b=$('o'+i);
if(G.shuf[i]==q[1][0]){clearInterval(T);b.classList.add('good');G.score+=50+(G.tm?0:TL*2);G.res[G.st][G.q]=G.hint?'h':'s';G.mood=['happy','happy'];
document.querySelectorAll('.opt').forEach(x=>x.style.pointerEvents='none');setTimeout(()=>{G.q=null;render()},900)}
else{b.classList.add('bad');G.score=Math.max(0,G.score-5);G.mood=['sad','think'];const m=document.querySelector('.ov svg');if(m)m.outerHTML=ch2().replace('<svg','<svg');}}
function nextStage(){G.scr=G.st==4?'win':'clear';G.mood=['happy','happy'];render()}
newG();render();
</script></body></html>
